% The Language of Discovery: shared style for all units. Compile with XeLaTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{common/lod}

\RequirePackage[fontset=none,scheme=plain]{ctex}
\RequirePackage{geometry}
\geometry{a4paper,left=2.3cm,right=2.3cm,top=2.3cm,bottom=2.2cm,headsep=0.7cm,footskip=0.9cm}
\RequirePackage{amsmath}
\RequirePackage{fontspec}
\RequirePackage[math-style=ISO,bold-style=ISO]{unicode-math}
\setmainfont{Libertinus Serif}
\setsansfont{Libertinus Sans}
\setmonofont{Consolas}[Scale=0.86]
\setmathfont{Libertinus Math}
\setCJKmainfont{Microsoft YaHei}[Scale=0.88,BoldFont={Microsoft YaHei Bold}]
\setCJKsansfont{Microsoft YaHei}[Scale=0.88,BoldFont={Microsoft YaHei Bold}]
\setCJKmonofont{Microsoft YaHei}[Scale=0.84]
% Upright d, e, etc. stay as typed; upright variables are not used.
\ctexset{autoindent=0pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt}
\linespread{1.12}

\RequirePackage[dvipsnames,table]{xcolor}
\definecolor{lodnavy}{HTML}{1F3A5F}
\definecolor{lodhead}{HTML}{E8EDF2}
\definecolor{lodgray}{HTML}{5F6B76}
\definecolor{lodrust}{HTML}{B5532A}
\definecolor{lodpale}{HTML}{F5F7F9}

\RequirePackage{array,booktabs,tabularx,longtable,multirow}
\RequirePackage{needspace}
\RequirePackage{enumitem}
\setlist{nosep,leftmargin=*,itemsep=3pt,topsep=3pt}
\RequirePackage{graphicx}
\RequirePackage{caption}
\captionsetup{font=small,labelfont={bf,color=lodnavy},labelsep=period,justification=raggedright,singlelinecheck=false}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,calc,decorations.pathreplacing,patterns}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18,every axis/.append style={tick label style={font=\footnotesize},label style={font=\small},legend style={font=\footnotesize,draw=none,fill=none}}}
\RequirePackage[skins,breakable]{tcolorbox}
\RequirePackage{listings}
\lstset{basicstyle=\ttfamily\small,keywordstyle=\color{lodnavy}\bfseries,commentstyle=\color{lodgray},
  stringstyle=\color{lodrust},columns=fullflexible,keepspaces=true,breaklines=true,frame=none,
  backgroundcolor=\color{lodpale},xleftmargin=4pt,xrightmargin=4pt,aboveskip=6pt,belowskip=6pt,showstringspaces=false}
\RequirePackage{fancyhdr}
\RequirePackage[hidelinks,bookmarksnumbered=false]{hyperref}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\newcommand{\lodunit}{}
\fancyhead[L]{\sffamily\footnotesize\color{lodgray}The Language of Discovery}
\fancyhead[R]{\sffamily\footnotesize\color{lodgray}\lodunit}
\fancyfoot[C]{\sffamily\footnotesize\color{lodgray}\thepage}

% Unit title block: \unittitle{P1}{English title}{中文标题}{来源}
\newcommand{\unittitle}[4]{%
  \renewcommand{\lodunit}{Unit #1}%
  \thispagestyle{plain}%
  {\sffamily\small\color{lodrust}\textbf{The Language of Discovery}\quad·\quad Part I Physics\quad·\quad Unit #1\par}
  \vspace{4pt}
  {\sffamily\fontsize{22}{27}\selectfont\bfseries\color{lodnavy}#2\par}
  \vspace{3pt}
  {\large\color{lodnavy}#3\par}
  \vspace{2pt}
  {\small\color{lodgray}#4\par}
  \vspace{4pt}{\color{lodnavy}\rule{\linewidth}{1.2pt}}\par\vspace{4pt}}

% Module heading: \module{English}{中文}{时间}
\newcommand{\module}[3]{%
  \par\addvspace{12pt}\Needspace{7\baselineskip}%
  \phantomsection\addcontentsline{toc}{section}{#1}%
  \pdfbookmark[1]{#1}{#1}%
  \noindent{\sffamily\Large\bfseries\color{lodnavy}#1}\enskip{\normalsize\color{lodnavy}#2}\hfill{\footnotesize\sffamily\color{lodrust}#3}\par
  \nopagebreak\vspace{-3pt}{\color{lodnavy}\rule{\linewidth}{0.5pt}}\par\nopagebreak\addvspace{3pt}}

% Subheading inside a module
\newcommand{\sub}[1]{\par\addvspace{7pt}\Needspace{4\baselineskip}\noindent{\sffamily\bfseries\color{lodnavy}#1}\par\nopagebreak}
% Task heading: \task{标题}{时间}
\newcommand{\task}[2]{\par\addvspace{8pt}\Needspace{5\baselineskip}\noindent{\sffamily\bfseries\color{lodnavy}#1}\hfill{\footnotesize\sffamily\color{lodrust}#2}\par\nopagebreak}
% Small gray teacher-style note (used in answers)
\newcommand{\note}[1]{{\small\color{lodgray}#1}}

% Main Text layout: wide outer margin for glosses, numbered paragraphs
\newcommand{\maintextlayout}{\newgeometry{left=2.3cm,right=5.3cm,top=2.3cm,bottom=2.2cm,marginparwidth=3.5cm,marginparsep=0.5cm,headsep=0.7cm,footskip=0.9cm}%
  \fancyheadoffset[R]{3cm}}
\newcommand{\normallayout}{\restoregeometry\fancyheadoffset[R]{0pt}}
\newcounter{lodpara}
\newcommand{\pn}{\refstepcounter{lodpara}\par\noindent\llap{\footnotesize\sffamily\color{lodgray}\thelodpara\hspace{6pt}}}
\newcommand{\gl}[2]{\marginpar{\raggedright\footnotesize\linespread{1.0}\selectfont\textbf{#1}\ #2\par}}
\newcommand{\artsec}[1]{\par\addvspace{8pt}\noindent{\sffamily\bfseries\color{lodnavy}#1}\par\nopagebreak}

\newtcolorbox{abstractbox}{enhanced,breakable,colback=lodpale,colframe=lodpale,boxrule=0pt,
  left=8pt,right=8pt,top=6pt,bottom=6pt,arc=0pt,borderline west={2pt}{0pt}{lodnavy}}
\newtcolorbox{tipbox}{enhanced,breakable,colback=lodpale,colframe=lodpale,boxrule=0pt,
  left=8pt,right=8pt,top=5pt,bottom=5pt,arc=0pt}

\newcommand{\headrow}{\rowcolor{lodhead}}
\newcommand{\ipa}[1]{{\footnotesize\color{lodgray}/#1/}}
\newcommand{\unit}[1]{\,\mathrm{#1}}
